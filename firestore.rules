rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // 1. Global Zero-Trust Deny Net
    match /{document=**} {
      allow read, write: if false;
    }

    // ----------------------------------------------------
    // REUSABLE HELPER CONSTRAINTS & ATTRIBUTE ACCESS
    // ----------------------------------------------------
    function isValidId(id) {
      return id is string && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    function isSignedIn() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }

    function isAdmin() {
      return isSignedIn() && (
        request.auth.token.email == "t3ch.frpbypass33@gmail.com" ||
        (
          exists(/databases/$(database)/documents/users/$(request.auth.uid)) &&
          get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == "admin"
        )
      );
    }

    // ----------------------------------------------------
    // USERS COLLECTION POOL ({userId})
    // ----------------------------------------------------
    function isValidUser(data) {
      return data.keys().hasAll(['id', 'email', 'role', 'createdAt']) && 
             data.keys().size() == 4 &&
             data.id is string && data.id.size() <= 128 &&
             data.email is string && data.email.size() <= 256 &&
             data.role is string && (data.role == "user" || data.role == "admin") &&
             data.createdAt is string && data.createdAt.size() <= 64;
    }

    match /users/{userId} {
      allow get: if isOwner(userId) || isAdmin();
      
      allow create: if isSignedIn() && 
                    isValidId(userId) && 
                    isValidUser(request.resource.data) && 
                    request.resource.data.id == userId && 
                    (request.resource.data.role == "user" || request.auth.token.email == "t3ch.frpbypass33@gmail.com");
                    
      allow update: if isSignedIn() && 
                    isValidId(userId) && 
                    isValidUser(request.resource.data) && 
                    request.resource.data.id == userId && 
                    (isAdmin() || (isOwner(userId) && request.resource.data.role == resource.data.role));
    }

    // ----------------------------------------------------
    // FAVORITES COLLECTION POOL ({favoriteId})
    // ----------------------------------------------------
    function isValidFavorite(data) {
      return data.keys().hasAll(['userId', 'matchId', 'createdAt']) && 
             data.keys().size() == 3 &&
             data.userId is string && data.userId.size() <= 128 &&
             data.matchId is string && data.matchId.size() <= 64 &&
             data.createdAt is string && data.createdAt.size() <= 64;
    }

    match /favorites/{favoriteId} {
      allow get: if isSignedIn() && isValidId(favoriteId) && (resource.data.userId == request.auth.uid || isAdmin());
      
      allow list: if isSignedIn() && (resource.data.userId == request.auth.uid || isAdmin());
      
      allow create: if isSignedIn() && 
                    isValidId(favoriteId) && 
                    isValidFavorite(request.resource.data) && 
                    (request.resource.data.userId == request.auth.uid || isAdmin());
                    
      allow delete: if isSignedIn() && 
                    isValidId(favoriteId) && 
                    (resource.data.userId == request.auth.uid || isAdmin());
    }

    // ----------------------------------------------------
    // PREDICTION HISTORY COLLECTION POOL ({historyId})
    // ----------------------------------------------------
    function isValidHistory(data) {
      return data.keys().hasAll(['userId', 'matchId', 'predictionHome', 'predictionAway', 'createdAt']) && 
             data.keys().size() == 5 &&
             data.userId is string && data.userId.size() <= 128 &&
             data.matchId is string && data.matchId.size() <= 64 &&
             data.predictionHome is int &&
             data.predictionAway is int &&
             data.createdAt is string && data.createdAt.size() <= 64;
    }

    match /history/{historyId} {
      allow get: if isSignedIn() && isValidId(historyId) && (resource.data.userId == request.auth.uid || isAdmin());
      
      allow list: if isSignedIn() && (resource.data.userId == request.auth.uid || isAdmin());
      
      allow create: if isSignedIn() && 
                    isValidId(historyId) && 
                    isValidHistory(request.resource.data) && 
                    (request.resource.data.userId == request.auth.uid || isAdmin());
                    
      allow delete: if isSignedIn() && 
                    isValidId(historyId) && 
                    (resource.data.userId == request.auth.uid || isAdmin());
    }

    // ----------------------------------------------------
    // INTERACTIVES / ANALYSIS COLLECTION POOL ({matchId})
    // ----------------------------------------------------
    function isValidAnalysis(data) {
      return data.keys().hasAll(['matchId', 'analysisText', 'createdAt']) && 
             data.keys().size() == 3 &&
             data.matchId is string && data.matchId.size() <= 64 &&
             data.analysisText is string && data.analysisText.size() <= 100000 &&
             data.createdAt is string && data.createdAt.size() <= 64;
    }

    match /analyses/{matchId} {
      allow get: if isSignedIn() && isValidId(matchId);
      allow list: if isSignedIn();
      allow write: if isAdmin() && isValidId(matchId) && isValidAnalysis(request.resource.data);
    }
  }
}
